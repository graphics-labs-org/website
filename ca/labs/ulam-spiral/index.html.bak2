            'ja': { 
                nav_main: "← メインハブ", nav_math: "← 数学ハブ", 
                title: "ウラムの螺旋", desc: "素数の可視化。", 
                lbl_max: "最大値 (N):", lbl_zoom: "ズーム:", lbl_start: "開始:", 
                btn_gen: "生成", btn_save: "HD保存(PNG)", 
                canvas_note: "高解像度画像 (3x) PNG。", 
                history_title: "発見", 
                p1: "1963年に発見。素数は対角線上に並びます。", 
                why_title: "なぜ螺旋？", 
                p_why_1: "螺旋は目に見えない構築方法です。すべての数字が見えれば、正方形の螺旋が見えるでしょう。", 
                p_why_2: "線を消して素数だけを残すと、驚くべきことにそれらは対角線を形成します。", 
                p_why_summary: "要するに：これは劇場の座席配置に関するもので、人がどこに座るかではありません。", 
                math_title: "数学", 
                p3: "対角線はオイラーのような多項式に対応しています。", 
                p4: "構造を見るために最大値を増やしてください。", 
                legal: "法的通知", privacy: "プライバシー", cookies: "クッキー", contact: "連絡先", coffee: "コーヒーを奢る" 
            }
        };

        let currentLang = 'es';

        
        
        
        function setLang(lang) {
            const l = lang.toLowerCase();
            localStorage.setItem('gl_lang', l);
            const t = translations[l] || translations['es'] || translations['en'];

            if (!t) return;

            // 1. Update elements with data-i18n attribute
            document.querySelectorAll('[data-i18n]').forEach(el => {
                const key = el.getAttribute('data-i18n');
                if (t[key]) {
                    if (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA') {
                        el.placeholder = t[key];
                    } else {
                        el.innerHTML = t[key];
                    }
                }
            });

            // 2. Fallback for ID-based translations (specific to this lab)
            Object.keys(t).forEach(key => {
                const possibleIds = [key, 'txt-' + key, 'info-h-' + key, 'info-p-' + key, key.replace('_', '-')];
                possibleIds.forEach(id => {
                    const el = document.getElementById(id);
                    if (el && t[key]) {
                        if (t[key].includes('<')) el.innerHTML = t[key];
                        else el.innerText = t[key];
                    }
                });
            });

            // 3. Highlight active language buttons
            document.querySelectorAll('.lang-switch button, .lang-btn').forEach(btn => {
                btn.classList.toggle('active', btn.id === 'btn-' + l || btn.innerText.toLowerCase() === l);
            });
        }
        window.setLang = setLang;

        function switchLangUrl(lang) {
            const pathParts = window.location.pathname.split('/');
            const langIndex = pathParts.findIndex(p => ['es', 'ca', 'en', 'fr', 'de', 'pt', 'it', 'nl', 'ja'].includes(p));
            if (langIndex !== -1) {
                pathParts[langIndex] = lang.toLowerCase();
                window.location.href = pathParts.join('/');
            } else {
                setLang(lang);
            }
        }
        window.switchLangUrl = switchLangUrl;

        document.addEventListener('DOMContentLoaded', () => {
            const pathParts = window.location.pathname.split('/');
            const urlLang = pathParts.find(p => ['es', 'ca', 'en', 'fr', 'de', 'pt', 'it', 'nl', 'ja'].includes(p));
            const lang = urlLang || localStorage.getItem('gl_lang') || 'es';
            setLang(lang);
        });
    

        /* --- 4. FONDO DE PARTÍCULAS (DINÁMICO) --- */
        const bgCanvas = document.getElementById('bg-canvas');
        const bgCtx = bgCanvas.getContext('2d');
        let particlesArray = [];
        
        function resizeBg() { bgCanvas.width = window.innerWidth; bgCanvas.height = window.innerHeight; }
        window.addEventListener('resize', () => { resizeBg(); initParticles(); });
        resizeBg();

        const mouse = { x: null, y: null, radius: 150 };
        window.addEventListener('mousemove', (e) => { mouse.x = e.x; mouse.y = e.y; });

        class Particle {
            constructor() {
                this.x = Math.random() * bgCanvas.width;
                this.y = Math.random() * bgCanvas.height;
                this.size = Math.random() * 12 + 8;
                this.speedX = (Math.random() * 1) - 0.5;
                this.speedY = (Math.random() * 1) - 0.5;
                this.density = (Math.random() * 30) + 1;
                const symbols = ['π', '∞', '∑', '∫', '√', '≈', '≠', '0', '1', 'e', 'x', 'y'];
                this.text = symbols[Math.floor(Math.random() * symbols.length)];
            }
            draw() {
                bgCtx.font = this.size + 'px monospace';
                bgCtx.fillStyle = 'rgba(0, 255, 65, 0.15)'; 
                bgCtx.fillText(this.text, this.x, this.y);
            }
            update() {
                this.x += this.speedX;
                this.y += this.speedY;
                if (mouse.x != null) {
                    let dx = mouse.x - this.x;
                    let dy = mouse.y - this.y;
                    let distance = Math.sqrt(dx*dx + dy*dy);
                    if (distance < mouse.radius) {
                        const forceDirectionX = dx / distance;
                        const forceDirectionY = dy / distance;
                        const force = (mouse.radius - distance) / mouse.radius;
                        this.x -= forceDirectionX * force * this.density / 10;
                        this.y -= forceDirectionY * force * this.density / 10;
                    }
                }
                if (this.x > bgCanvas.width) this.x = 0; if (this.x < 0) this.x = bgCanvas.width;
                if (this.y > bgCanvas.height) this.y = 0; if (this.y < 0) this.y = bgCanvas.height;
                this.draw();
            }
        }

        function initParticles() {
            particlesArray = [];
            let numberOfParticles = (bgCanvas.height * bgCanvas.width) / 9000;
            for (let i = 0; i < numberOfParticles; i++) particlesArray.push(new Particle());
        }
        function animateParticles() {
            bgCtx.clearRect(0, 0, bgCanvas.width, bgCanvas.height);
            for (let i = 0; i < particlesArray.length; i++) particlesArray[i].update();
            requestAnimationFrame(animateParticles);
        }
        initParticles(); animateParticles();

        /* --- 5. LÓGICA ESPIRAL DE ULAM --- */
        const ulamCanvas = document.getElementById('ulam-canvas');
        const ctx = ulamCanvas.getContext('2d');

        function isPrime(num) {
            if (num <= 1) return false; if (num <= 3) return true;
            if (num % 2 === 0 || num % 3 === 0) return false;
            for (let i = 5; i * i <= num; i += 6) if (num % i === 0 || num % (i + 2) === 0) return false;
            return true;
        }

        function renderSpiral(targetCtx, width, height, max, start, zoom, scaleFactor) {
            targetCtx.fillStyle = '#000000'; targetCtx.fillRect(0, 0, width, height);
            targetCtx.fillStyle = '#00ff41';
            let x = Math.floor(width / 2); let y = Math.floor(height / 2);
            const stepSize = zoom * scaleFactor; 
            const dx = [1, 0, -1, 0]; const dy = [0, -1, 0, 1];
            let dir = 0; let stepsInSegment = 1; let stepsTaken = 0; let turnCounter = 0; let currentNum = start;
            for (let i = 0; i < max; i++) {
                if (x >= -stepSize && x <= width + stepSize && y >= -stepSize && y <= height + stepSize) {
                    if (isPrime(currentNum)) {
                        if (zoom === 1 && scaleFactor === 1) targetCtx.fillRect(x, y, 1, 1);
                        else {
                            targetCtx.beginPath();
                            const radius = (zoom * scaleFactor) / 2.5; 
                            targetCtx.arc(x + (stepSize / 2), y + (stepSize / 2), radius, 0, Math.PI*2);
                            targetCtx.fill();
                        }
                    }
                }
                x += dx[dir] * stepSize; y += dy[dir] * stepSize;
                currentNum++; stepsTaken++;
                if (stepsTaken === stepsInSegment) {
                    stepsTaken = 0; dir = (dir + 1) % 4; turnCounter++;
                    if (turnCounter % 2 === 0) stepsInSegment++;
                }
            }
        }

        function generateSpiral() {
            let max = parseInt(document.getElementById('inp-max').value);
            let start = parseInt(document.getElementById('inp-start').value);
            let zoom = parseInt(document.getElementById('inp-zoom').value);
            const spiralSide = Math.ceil(Math.sqrt(max));
            const canvasSize = (spiralSide * zoom) + (zoom * 20); 
            const MAX_SCREEN_DIM = 4000;
            let finalW = canvasSize > MAX_SCREEN_DIM ? MAX_SCREEN_DIM : canvasSize;
            ulamCanvas.width = finalW; ulamCanvas.height = finalW;
            renderSpiral(ctx, finalW, finalW, max, start, zoom, 1);
        }

        function saveImage() {
            let max = parseInt(document.getElementById('inp-max').value);
            let start = parseInt(document.getElementById('inp-start').value);
            let zoom = parseInt(document.getElementById('inp-zoom').value);
            const HD_SCALE = 3; 
            const spiralSide = Math.ceil(Math.sqrt(max));
            const baseSize = (spiralSide * zoom) + (zoom * 20);
            const tempCanvas = document.createElement('canvas');
            const hdSize = baseSize * HD_SCALE;
            const finalHdSize = hdSize > 12000 ? 12000 : hdSize;
            tempCanvas.width = finalHdSize; tempCanvas.height = finalHdSize;
            const tempCtx = tempCanvas.getContext('2d');
            renderSpiral(tempCtx, finalHdSize, finalHdSize, max, start, zoom, HD_SCALE);
            const link = document.createElement('a');
            link.download = `ulam_spiral_HD_${max}.png`;
            link.href = tempCanvas.toDataURL('image/png'); link.click();
        }

        const saved = localStorage.getItem('gl_lang') || 'es';
        setTimeout(generateSpiral, 100); 
    </script>
</body>
</html>
